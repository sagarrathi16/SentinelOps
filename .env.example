# SentinelOps Environment Configuration
# Copy this file to .env before starting services

# Switch Core Configuration
SWITCH_CORE_HOST=localhost
SWITCH_CORE_PORT=8000
SWITCH_CALLBACK_PORT=8081
SWITCH_AGENT_ID=sentinelops-triage-commander
SWITCH_AGENT_API_KEY=sk_live_switch_sentinelops_9921a8f

# Mattermost ChatOps Integration
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOT_TOKEN=bot_token_sentinelops_demo_secret
MATTERMOST_TEAM_NAME=engineering
MATTERMOST_CHANNEL_NAME=incident-checkout
MATTERMOST_WEBHOOK_URL=http://localhost:8065/hooks/incoming_demo_hook

# Target Service Configuration
TARGET_SERVICE_URL=http://localhost:8080
TARGET_SERVICE_REPO_DIR=./target_service

# Switch Trust & Guardrails Configuration
SWITCH_TRUST_API_KEY=st_mock_or_cloud_key_12345
SWITCH_TRUST_REQUIRE_GUARDRAILS=true
SWITCH_TRUST_REDACT_PII=true

# Wispr Flow Dictation Configuration
WISPR_FLOW_HOTKEY=ctrl+space
WISPR_FLOW_APP_ACTIVE=true

# Execution Mode: simulation | live
EXECUTION_MODE=simulation

