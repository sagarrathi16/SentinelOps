{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Switch-Trust-Static-Analyzer",
          "semanticVersion": "1.4.0",
          "informationUri": "https://sandboxaq.com/switch-trust",
          "rules": [
            {
              "id": "ST-OWASP-LLM01",
              "name": "PromptInjectionVulnerability",
              "shortDescription": {
                "text": "Checks for unvalidated prompt injection entry points"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ST-OWASP-LLM06",
              "name": "SensitiveInformationDisclosure",
              "shortDescription": {
                "text": "Checks for raw PII/credential leakage into agent context"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [],
      "invocations": [
        {
          "executionSuccessful": true,
          "endTimeUtc": "2026-11-04T12:00:00Z"
        }
      ]
    }
  ]
}

